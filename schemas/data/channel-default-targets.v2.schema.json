{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codex-to-im.local/schemas/data/channel-default-targets.v2.schema.json",
  "title": "Codex-to-IM data/channel-default-targets.json",
  "description": "Map of channel instance id to one-shot default bridge session records.",
  "type": "object",
  "additionalProperties": {
    "$ref": "#/$defs/channelDefaultTarget"
  },
  "$defs": {
    "channelDefaultTarget": {
      "type": "object",
      "required": ["id", "channelType", "bridgeSessionId", "createdAt", "updatedAt"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "channelType": {
          "type": "string",
          "minLength": 1
        },
        "channelProvider": {
          "type": "string"
        },
        "channelAlias": {
          "type": "string"
        },
        "bridgeSessionId": {
          "type": "string",
          "minLength": 1
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  }
}
